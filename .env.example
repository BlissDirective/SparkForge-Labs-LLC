# ════════════════════════════════════════════════════
# SPARKFORGE ENVIRONMENT VARIABLES
# Copy this file to .env.local and replace with real values
# NEVER commit .env.local — it contains secrets!
# ════════════════════════════════════════════════════

# ═══ Supabase ═══
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi…your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi…your-service-role-key

# ═══ Anthropic AI (server-side ONLY — never in client bundle) ═══
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ═══ Stripe (payment processing) ═══
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_PLUS_MONTHLY_ID=price_plus_monthly
STRIPE_PLUS_YEARLY_ID=price_plus_yearly
STRIPE_FORGE_MONTHLY_ID=price_forge_monthly
STRIPE_FORGE_YEARLY_ID=price_forge_yearly

# ═══ App Configuration ═══
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=generate-a-random-string-here

# ═══ Dev / Branding Routes (preview-only override) ═══
# Set to "true" ONLY on Vercel preview environments where you want the
# /dev/branding visual checkpoint to be reachable. Production deployments
# MUST leave this unset so the dev showcase stays 404 to the public.
# NEXT_PUBLIC_ALLOW_DEV_ROUTES=true

# ═══ CSRF (AUTH-HIGH-004) ═══
# HMAC secret for CSRF tokens. Generate a random 32+ char string.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset (not ideal in prod —
# set explicitly so CSRF tokens survive service-key rotations).
CSRF_SECRET=generate-a-random-32-char-string-here

# ═══ Feature Flags ═══
# Set to "true" or "false" to enable/disable features.
# These are evaluated at runtime via process.env[`NEXT_PUBLIC_FF_${flag}`].
# All flags default to false (off) when unset.
#
# Phase 1–4 flags (stable)
NEXT_PUBLIC_FF_WELCOME_ACHIEVEMENT=false
NEXT_PUBLIC_FF_LEVEL_CEREMONY=false
NEXT_PUBLIC_FF_PARENT_DASHBOARD=false
NEXT_PUBLIC_FF_CONTENT_AGENT=false
NEXT_PUBLIC_FF_OFFLINE_MODE=false
#
# Phase 5 flags (Ultra / Max tier — experimental, off by default)
# NEXT_PUBLIC_FF_OFFSCREEN_RENDER=false          # OffscreenCanvas worker rendering (requires COOP/COEP headers)
# NEXT_PUBLIC_FF_OFFSCREEN_RENDER_TELEMETRY=false
# NEXT_PUBLIC_FF_OFFSCREEN_RENDER_AUTOQUALITY=false
# NEXT_PUBLIC_FF_PASSKEY_AUTH=false              # WebAuthn passkey login
# NEXT_PUBLIC_FF_SIGNED_DEMO_TOKENS=false        # Supabase anonymous auth for demo sessions
# NEXT_PUBLIC_FF_COMMAND_PALETTE=false           # ⌘K command palette
# NEXT_PUBLIC_FF_PRORATION_PREVIEW=false         # Stripe proration preview on plan change
# NEXT_PUBLIC_FF_OPTIMISTIC_OFFLINE_CACHE=false  # Optimistic writes + IndexedDB offline cache
# NEXT_PUBLIC_FF_MFA_TOTP=false                  # TOTP MFA for parents (/settings/mfa)
# NEXT_PUBLIC_FF_BATCHED_COCKPIT=false           # BatchedMesh cockpit chrome (perf)

# ═══ Sentry (Enhancement 8.1 — Error Tracking + Monitoring) ═══
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o123456.ingest.sentry.io/1234567
SENTRY_DSN=https://your-dsn@o123456.ingest.sentry.io/1234567
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=sparkforge
# Required at BUILD time for source-map upload to Sentry (not a runtime secret).
# Set in Vercel Dashboard → Settings → Environment Variables → scope: Preview + Production.
SENTRY_AUTH_TOKEN=sntrys_your-auth-token
# DEPLOY-HIGH-003: Optional — slug of a Sentry Cron Monitor that
# /api/health will check into on every hit. Leave unset to disable.
SENTRY_HEALTH_MONITOR_SLUG=sparkforge-health
# Optional overrides — both fall back to Vercel-injected values automatically.
# SENTRY_ENVIRONMENT=production   # falls back to VERCEL_ENV → NODE_ENV
# SENTRY_RELEASE=abc123           # falls back to VERCEL_GIT_COMMIT_SHA

# ═══ Auth CAPTCHA (AUTH-MED-003) ═══
# Provider-agnostic client plumbing for the CAPTCHA token that Supabase
# Auth accepts on signInWithPassword / signUp / resetPasswordForEmail
# when CAPTCHA is enabled in the Supabase Dashboard (Auth → Settings →
# Attack Protection → Enable CAPTCHA protection). Supported providers:
# hCaptcha, Cloudflare Turnstile. Configure the SECRET on the Supabase
# dashboard; the SITE KEY below is public and loads the widget.
#
# Leave BOTH unset to disable the CAPTCHA widget UI. When CAPTCHA is
# enabled in the Supabase dashboard but the widget env is unset, Supabase
# will return a 422 on submit and the client will surface the error to
# the user so you notice the misconfiguration quickly.
NEXT_PUBLIC_CAPTCHA_PROVIDER=hcaptcha
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your-hcaptcha-or-turnstile-site-key

# ═══ Upstash Redis (rate limiting — AUTH-HIGH-003) ═══
# Required in production. Without these, rate limits fall back to an
# in-memory Map that is NOT shared across serverless instances (i.e.
# effectively useless on Vercel). Create a free DB at
# https://console.upstash.com → Redis → Create database, then paste
# the REST URL + REST token below.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ═══ Email (Resend — trial reminders, admin notifications) ═══
# Get key from: https://resend.com/api-keys
# Leave unset to disable email (cron returns 200 skipped).
RESEND_API_KEY=re_your-resend-api-key
# Optional — default: "SparkForge <noreply@sparkforge.app>"
# Must be a domain you've verified in the Resend dashboard.
EMAIL_FROM=SparkForge <noreply@yourdomain.com>

# ═══ Build / CI escape hatches ═══
# Set SKIP_ENV_VALIDATION=1 to bypass the production env-var boot check
# during a one-off build (e.g. a CI preview without all secrets).
# NEVER set this on a real production deployment — it disables the
# startup guard that prevents silent misconfiguration.
# SKIP_ENV_VALIDATION=1

# ═══ Debug / Development ═══
# Set NEXT_PUBLIC_DEBUG_RENDERER=1 to enable verbose WebGPU renderer
# logging in the browser console. Dev-only; leave unset in production.
# NEXT_PUBLIC_DEBUG_RENDERER=1

# ═══ Vercel auto-injected (do NOT set manually) ═══
# These are automatically set by Vercel — do not add them to your dashboard:
#   VERCEL_ENV            — "production" | "preview" | "development"
#   VERCEL_GIT_COMMIT_SHA — full commit SHA of the deployed commit
#   NODE_ENV              — "production" on all Vercel deployments
#
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA is NOT auto-injected; enable it via:
#   Vercel Dashboard → Project → Settings → Environment Variables →
#   "Expose System Environment Variables" toggle (or add it explicitly).
#
# OTEL_EXPORTER_OTLP_ENDPOINT is auto-injected on Vercel Pro when
#   OpenTelemetry is enabled in the Vercel dashboard. No manual setup needed.

# ═══ Deployment (set in Vercel Dashboard) ═══
ENABLE_CONTENT_AGENT=true
