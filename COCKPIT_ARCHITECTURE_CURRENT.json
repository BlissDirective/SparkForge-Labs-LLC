    "materials": "cockpitMaterials.ts — 7 factories (alloyFrame, controlPanel, holographic, button, bezel, console, LED)",
    "pages": {
      "home": "Stats + lab progress + daily challenge + continue learning CTA. setLabColor(#00BBFF) on mount.",
