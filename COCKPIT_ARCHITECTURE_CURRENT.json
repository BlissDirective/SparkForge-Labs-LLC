  "canvas": {
    "type": "Single Persistent (CPA2-1, D3D-B1)",
    "component": "CockpitCanvas.tsx",
    "neverUnmounts": true,
    "position": "fixed inset-0 z-0",
    "camera": { "position": [0, 0.65, 1.1], "fov": 58, "near": 0.1, "far": 200, "note": "v3: tight-focus cockpit seat (was [0, 6.5, 7])" },
    "renderer": { "antialias": true, "alpha": true, "dpr": [1, 3], "logarithmicDepthBuffer": true },
    "environment": "frost-prismatic.hdr"
  },

  "sceneRouter": {
    "component": "SceneRouter.tsx",
    "scenes": ["hero", "cockpit", "spatial", "game", "transitioning"],
    "visibilityControl": "opacity interpolation per group",
    "cockpitFadeDuringGame": 0.2
  },

  "cockpitShell": {
    "mainPanels": {
