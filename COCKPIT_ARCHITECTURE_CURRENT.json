{
  "meta": {
    "project": "SparkForge",
    "version": "CPA v3.0 — 3D-Embedded UI (March 27, 2026)",
    "date": "2026-03-27",
    "totalTriangleBudget": 50000000,
    "cockpitBudget": 38000000,
    "gameBudget": 12000000
