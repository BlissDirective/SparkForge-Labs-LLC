## Integration Guide

### How to use in any game:

```tsx
// 1. Wrap your game page (or layout) with XPPopupProvider
import { XPPopupProvider } from '@/components/game/XPPopup';

function GamePage() {
  return (
    <XPPopupProvider>
      <YourGameComponent />
    </XPPopupProvider>
  );
}

// 2. Inside any game component, use the hook:
import { useXPPopup } from '@/components/game/XPPopup';
import { StreakFire } from '@/components/game/StreakFire';
import { GameCompleteCelebration } from '@/components/game/GameCompleteCelebration';

function YourGameComponent() {
  const { showXP } = useXPPopup();
  const [streak, setStreak] = useState(0);
  const [showCelebration, setShowCelebration] = useState(false);

  function onCorrect() {
    const newStreak = streak + 1;
    setStreak(newStreak);
    const bonus = newStreak >= 5 ? 3 : newStreak >= 3 ? 2 : 1;
    const xp = 10 * bonus;
    game.addScore(xp);

    // Show floating XP popup with combo
    showXP(xp, { combo: newStreak, color: '#10B981' });
  }

  function onGameComplete() {
    setShowCelebration(true);
  }

  return (
    <div className="relative">
      {/* Streak fire effect behind content */}
      <StreakFire streak={streak} worldColor="#8B5CF6" />

      {/* Your game UI here */}
      ...

      {/* Celebration overlay */}
      <GameCompleteCelebration
        show={showCelebration}
        score={game.score}
        totalRounds={10}
        roundsCompleted={8}
        xpReward={25}
        worldColor="#8B5CF6"
        gameTitle="Data Detective"
        badge={{ emoji: '🔍', title: 'Data Guardian' }}
        personalBest={true}
        onContinue={() => router.push('/arcade')}
      />
    </div>
  );
}
