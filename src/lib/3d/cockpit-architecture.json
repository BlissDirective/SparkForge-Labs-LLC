      { "from": "lab-page",    "to": "game",        "trigger": "Game launch" },
      { "from": "game",        "to": "celebration",  "trigger": "Game complete" },
      { "from": "celebration", "to": "previous",     "trigger": "Animation complete (auto)" },
      { "from": "any",         "to": "overview",     "trigger": "Escape key" },
      { "from": "overview",    "to": "console",      "trigger": "Tab / Click console" },
      { "from": "lab-focus",   "to": "console",      "trigger": "Tab / Click console" },
      { "from": "console",     "to": "previous",     "trigger": "Escape / Click outside" }
    ],
    "heroPhases": {
      "states": ["idle", "animating", "materializing", "complete"],
      "flow": [
        { "from": "idle",           "to": "animating",     "trigger": "First visit / hero sequence starts" },
        { "from": "animating",      "to": "materializing", "trigger": "t=14s (hero Phase 6 → cockpit crossfade)" },
        { "from": "materializing",  "to": "complete",      "trigger": "t=19s (cockpit fully materialized)" }
      ]
    }
  },

