{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "SparkForge 3D Panoramic Cockpit Architecture",
    "version": "2.1",
    "specDate": "2026-03-20",
    "generatedDate": "2026-03-27",
    "description": "Complete architectural definition for the 3D panoramic cockpit — geometry, triangle budgets, LOD levels, presets, skins, audio zones, scene graph, transitions, and decision locks.",
    "sourceDocuments": [
      "docs/00-reference/3D_PANORAMIC_COCKPIT_ENHANCEMENT_v2.0.md",
      "docs/00-reference/Upgrade-3D-Panoramic-Cockpit-2026-03-20.md",
      "src/lib/3d/cockpitConfig.ts",
      "src/stores/cockpitStore.ts",
      "src/stores/sceneStore.ts",
      "src/lib/audio/cockpitAudio.ts"
    ],
    "decisionLocks": "CPA2-1 through CPA2-15, D3D-B1 through D3D-B6"
  },

  "canvas": {
    "component": "CockpitCanvas",
    "file": "src/components/3d/CockpitCanvas.tsx",
    "description": "Single persistent R3F Canvas for entire app lifecycle (CPA2-1, D3D-B1). Never unmounts.",
    "renderer": {
      "primary": "WebGPURenderer",
      "fallback": "WebGL2",
      "shaderLanguage": "TSL",
      "tslCompilationTargets": ["WGSL", "GLSL"]
    },
    "config": {
      "frameloop": "always",
      "dpr": [1, 3],
      "camera": {
        "position": [0, 0.65, 1.1],
        "fov": 58,
        "near": 0.1,
        "far": 200
      },
      "gl": {
        "antialias": true,
        "alpha": true,
        "powerPreference": "high-performance",
        "logarithmicDepthBuffer": true
      }
    },
    "zIndexStack": [
      { "zIndex": 0,  "layer": "R3F Canvas",            "content": "All 3D content (single canvas)" },
      { "zIndex": 5,  "layer": "CSS scanline-overlay",    "content": "CRT scanline effect" },
      { "zIndex": 10, "layer": "HTML SpatialOverlay",     "content": "Lab info panel, nav hints, console quick-access" },
      { "zIndex": 15, "layer": "HTML MiniMapOverlay",     "content": "Persistent mini-map (top-right)" },
      { "zIndex": 20, "layer": "HTML Dashboard Content",  "content": "Actual page content (cards, grids, forms)" },
      { "zIndex": 50, "layer": "HTML Modal Layer",        "content": "Modals, toasts, celebrations" }
    ]
  },

  "geometry": {
    "panelCurvature": 0.85,
    "totalWrapArc": 140,
    "panelRadius": 4.0,
    "centralViewportWidth": 0.56,
    "sidesPanelWidth": 0.12,
    "topBarHeight": 0.10,
    "consoleDeskHeight": 0.15,
    "statusBarHeight": 0.05,
    "hexRadius": 0.35,
    "hexDepth": 0.02,
    "hexDataTextureSize": 64,
    "panelEdgeBevel": 0.005,
    "topBarSegments": 256,
    "sideSegments": 128,
    "rivetSpacing": 0.15,
    "cableBundleCount": 50,
    "ventPanelCount": 12,
    "floorGrateResolution": 64
  },

  "adaptiveCurvature": {
    "ultraWide":   { "minWidth": 1920, "arc": 155, "radius": 4.2 },
    "desktop":     { "minWidth": 1440, "arc": 140, "radius": 4.0 }
