      "cyberpunk":  { "ledColor": "#FF00FF",  "hudRingColor": "magenta/cyan", "scanLineSweep": "neon pink",      "npcVisorColor": "#FF00FF", "particlePhysics": "drift-fast" },
      "space":      { "ledColor": "#4444FF",  "hudRingColor": "deep blue",   "scanLineSweep": "cool blue",      "npcVisorColor": "#AACCFF", "particlePhysics": "sparkle-slow" },
      "underwater": { "ledColor": "#00BBFF",  "hudRingColor": "aqua",        "scanLineSweep": "caustic pattern", "npcVisorColor": "#66DDFF", "particlePhysics": "rise-bubbles" },
      "crystal":    { "ledColor": "#AA66FF",  "hudRingColor": "purple",      "scanLineSweep": "prismatic",      "npcVisorColor": "#D946EF", "particlePhysics": "sparkle-orbit" }
    },
    "transitionSequence": {
      "totalDuration": 2500,
      "phases": [
        { "name": "dissolveOut", "start": 0,    "end": 500,  "description": "Current skin fades via dithered dissolve shader" },
        { "name": "flash",       "start": 500,  "end": 700,  "description": "Brief white flash (bloom spike to 2.0)" },
        { "name": "dissolveIn",  "start": 700,  "end": 2000, "description": "New skin elements materialize with particle burst" },
        { "name": "settle",      "start": 2000, "end": 2500, "description": "All elements reach steady state" }
      ]
    },
    "previewDuration": 30
  },

  "transitions": {
    "modeTransitions": {
      "dashboard-to-lab":        { "duration": 800,  "easing": "spring(300, 25)" },
      "lab-to-game":             { "duration": 600,  "easing": "easeInOut" },
      "game-to-lab":             { "duration": 400,  "easing": "easeOut" },
      "lab-to-dashboard":        { "duration": 800,  "easing": "spring(300, 25)" },
      "any-to-celebration":      { "duration": 200,  "easing": "easeIn" },
      "celebration-to-previous": { "duration": 1200, "easing": "easeOut" }
    },
    "irisTransition": {
      "component": "MechanicalIris",
      "duration": 600,
      "usedFor": ["cockpit-to-game", "game-to-cockpit"],
      "decision": "D3D-B2"
    },
    "wormholeTransition": {
      "component": "WormholeTransition",
      "file": "src/components/3d/WormholeTransition.tsx",
      "triangles": 300000,
      "totalDuration": 2500,
      "usedFor": "lab-to-lab within spatial dashboard",
      "sequence": [
        { "phase": "cameraAcceleration", "start": 0,    "end": 800,  "description": "Camera flies toward focused lab at increasing speed" },
        { "phase": "wormholeOpen",       "start": 800,  "end": 1200, "description": "Torus geometry expands, inner surface has lab-colored energy shader" },
        { "phase": "tunnelTransit",      "start": 1200, "end": 2000, "description": "Camera passes through CylinderGeometry tunnel with animated UV shader" },
        { "phase": "emerge",             "start": 2000, "end": 2500, "description": "Tunnel dissolves, lab page content fades in" }
      ]
    },
    "heroToCockpit": {
      "duration": 5000,
      "overlapWindow": { "heroFadeStart": 14000, "cockpitMaterializeStart": 14000, "heroFadeEnd": 17000, "cockpitCompleteAt": 19000 },
      "cameraHandoff": {
        "heroFinalPosition": [0, 0.65, 1.1],
        "heroFinalFov": 58,
        "cockpitStartPosition": [0, 0.65, 1.1],
        "cockpitStartFov": 58
      },
      "decision": "CPA2-3"
    }
  },

  "ceremonies": {
    "types": {
      "xp":              { "bloomPeak": 0.6, "particleCount": 50,  "hudExpansion": 1.1, "duration": 1500 },
      "badge":           { "bloomPeak": 0.8, "particleCount": 100, "hudExpansion": 1.3, "duration": 2000 },
      "levelUp":         { "bloomPeak": 1.0, "particleCount": 200, "hudExpansion": 1.5, "duration": 3000 },
      "gameComplete":    { "bloomPeak": 0.9, "particleCount": 150, "hudExpansion": 1.4, "duration": 2500 },
      "streakMilestone": { "bloomPeak": 0.7, "particleCount": 80,  "hudExpansion": 1.2, "duration": 2000 }
    },
    "sequence": [
      { "phase": "bloomSpike",   "start": 0.0, "end": 0.3, "description": "Bloom intensity jumps, vignette darkens" },
      { "phase": "hudFlare",     "start": 0.3, "end": 1.0, "description": "HUD rings expand, scan lines spin rapidly, core sphere pulses" },
      { "phase": "panelPulse",   "start": 1.0, "end": 1.5, "description": "Panels flash lab color, hex clusters strobe in sequence (50ms stagger)" },
      { "phase": "particleBurst","start": 1.5, "end": 2.0, "description": "Particles explode from center (additive blending, lab-colored, gravity-affected)" },
      { "phase": "settle",       "start": 2.0, "end": 3.0, "description": "All elements smoothly return to pre-ceremony state" }
    ],
    "component": "CeremonyFX",
    "file": "src/components/3d/CeremonyFX.tsx",
    "triangles": 500000
  },

