    "description": "Unified scene composition order within CockpitCanvas (painter's algorithm)",
    "layers": [
      {
        "name": "Background",
        "order": 1,
        "components": [
          { "name": "CockpitSkinManager", "description": "Skin-specific background (stars/nebula/caustics/crystals/grid)" },
          { "name": "AuroraBackground",   "triangles": 50000, "description": "Volumetric aurora layers, 3 ribbon TubeGeometry paths" }
        ]
      },
      {
        "name": "SpatialContent",
        "order": 2,
        "components": [
          { "name": "HolographicLabMap",   "triangles": 1000000,  "instances": 1 },
          { "name": "InteractiveConsole3D","triangles": 750000,   "instances": 4, "totalTriangles": 3000000 },
          { "name": "AmbientNPCs",         "triangles": 250000,   "instances": 8, "totalTriangles": 2000000 },
          { "name": "DynamicEnvironment",  "triangles": 3000000,  "instances": 1 }
        ]
      },
      {
        "name": "CockpitShell",
        "order": 3,
        "components": [
          { "name": "CockpitPanels",           "triangles": 4000000 },
          { "name": "LEDRim",                  "triangles": 500000 },
          { "name": "SidePanels",              "triangles": 3000000 },
          { "name": "StatusBar3D",             "triangles": 1000000 },
          { "name": "HolographicHUD",          "triangles": 1000000 },
          { "name": "CockpitStructuralDetail", "triangles": 2000000 },
          { "name": "CockpitFloor3D",          "triangles": 1000000 },
          { "name": "VolumetricFog3D",         "triangles": 500000 },
          { "name": "NavigationButtonGrid",    "triangles": 1000000, "description": "5 physical cockpit nav buttons (HOME/LABS/ARCADE/SETTINGS/PROFILE)" },
          { "name": "VariableDialCluster",     "triangles": 1500000, "description": "3 center-console dials, per-page auto-reconfigure" },
          { "name": "CenterViewportScreen",    "triangles": 3000000, "description": "Spherical panoramic screen (r=3.9, 144×72 segs, BackSide)" }
        ]
      },
      {
        "name": "Postprocessing",
        "order": 4,
        "effects": [
          { "name": "N8AO",                "description": "Screen-space ambient occlusion" },
          { "name": "Bloom",               "description": "Luminance glow, adaptive threshold per scene" },
          { "name": "ChromaticAberration",  "description": "RGB offset, sci-fi aesthetic" },
          { "name": "DepthOfField",         "description": "Subtle tilt-shift focus" },
          { "name": "Noise",               "description": "Film grain (6% opacity)" },
          { "name": "HueSaturation",       "description": "Per-lab color grading with hue shifts" },
          { "name": "BrightnessContrast",  "description": "Scene-reactive contrast" },
          { "name": "Vignette",            "description": "Edge darkening" },
          { "name": "BarrelDistortion",    "description": "Custom lens distortion" }
        ],
        "sceneMultipliers": {
          "game":          { "bloom": 1.2, "chromatic": 0.5, "ssao": 0.8, "dof": 0.5, "noise": 1.0, "vignette": 0.8, "barrel": 0.0 },
          "spatial":       { "bloom": 1.0, "chromatic": 0.8, "ssao": 1.2, "dof": 1.5, "noise": 0.8, "vignette": 1.0, "barrel": 2.0 },
          "hero":          { "bloom": 1.5, "chromatic": 1.2, "ssao": 0.6, "dof": 0.3, "noise": 1.2, "vignette": 1.2, "barrel": 1.5 },
          "transitioning": { "bloom": 1.8, "chromatic": 1.5, "ssao": 0.4, "dof": 0.2, "noise": 0.5, "vignette": 1.3, "barrel": 2.0 },
          "cockpit":       { "bloom": 1.0, "chromatic": 1.0, "ssao": 1.0, "dof": 1.0, "noise": 1.0, "vignette": 1.0, "barrel": 1.0 }
        }
      },
      {
        "name": "TransitionFX",
        "order": 5,
        "components": [
          { "name": "WormholeTransition", "triangles": 300000, "trigger": "lab entry/exit" },
          { "name": "CeremonyFX",         "triangles": 500000, "trigger": "achievement/level-up" },
          { "name": "MechanicalIris",     "trigger": "cockpit-to-game / game-to-cockpit" },
          { "name": "MiniMapOverlay3D",   "triangles": 250000, "persistent": true }
        ]
      }
    ]
  },

  "audio": {
    "engine": "CockpitAudioEngine",
    "file": "src/lib/audio/cockpitAudio.ts",
    "hook": "src/hooks/useCockpitAudio.ts",
    "api": "Web Audio API (native AudioContext)",
