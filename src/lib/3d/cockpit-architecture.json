  "stateMachine": {
    "description": "Cockpit mode state machine — navigation flow between spatial views",
    "states": ["overview", "lab-focus", "lab-page", "game", "celebration", "console"],
    "transitions": [
      { "from": "overview",    "to": "lab-focus",   "trigger": "Arrow / Click on lab" },
