      "navigationButtonGrid":     { "desktop": 1000000,  "description": "5 physical cockpit nav buttons (HOME/LABS/ARCADE/SETTINGS/PROFILE)" },
      "variableDialCluster":      { "desktop": 1500000,  "description": "3 center-console dials, per-page auto-reconfigure" },
      "centerViewportScreen":     { "desktop": 3000000,  "description": "Spherical panoramic screen (r=3.9, 144×72 segs, BackSide)" }
    },
    "dynamicHeadroom": { "desktop": 12200000 }
  },

  "fpsDegradation": [
    { "minFpsPercent": 0.9, "action": "Full quality" },
    { "minFpsPercent": 0.8, "action": "Reduce particle counts by 30%" },
    { "minFpsPercent": 0.6, "action": "Drop to next LOD level, disable BarrelDistortion" },
    { "minFpsPercent": 0.4, "action": "Disable HolographicHUD, reduce NPC count by half" }
