// ================================================================
// Voronoi Shatter — Compute Shader (WGSL)
// ================================================================
// GPU-accelerated Voronoi cell boundary computation for Phase 5.
// Pre-computes which shard each vertex belongs to.
//
// Input: seed point array + mesh vertex positions + bounding box
// Output: cell assignments per vertex (shard index)
// Workgroup size: 256 threads
//
// Used during Phase 5 initialization (pre-computed, not per-frame).
// CPU fallback: voronoiFracture.ts (Bowyer-Watson algorithm)
//
// Shard Counts by Tier:
//   webgpu-high:       100,000 shards
//   webgpu-mid:         50,000 shards
//   webgl2 (desktop):   10,000 shards
//   webgl2 (tablet):     2,000 shards
//   webgl2 (mobile):       500 shards
//   css:                     8 shards
//
// Spec: SparkForge_Hero_Page_Animation_v2.0.md Section 4, Phase 5

// ■■ Bindings ■■
// @group(0) @binding(0) — Vertex positions (vec3f[], read-only)
// @group(0) @binding(1) — Voronoi seed points (vec3f[], read-only)
// @group(0) @binding(2) — Output cell assignments (u32[], write)
// @group(0) @binding(3) — Uniforms: vertex count, seed count, bounding box

struct VoronoiUniforms {
  vertexCount: u32,
  seedCount: u32,
  bboxMin: vec3f,
  bboxMax: vec3f,
}

@group(0) @binding(0)
var<storage, read> vertices: array<vec3f>;

@group(0) @binding(1)
var<storage, read> seeds: array<vec3f>;

@group(0) @binding(2)
var<storage, read_write> cellAssignments: array<u32>;

@group(0) @binding(3)
var<uniform> params: VoronoiUniforms;

// ■■ Workgroup Configuration ■■
const WORKGROUP_SIZE: u32 = 256u;

// ■■ Shared Memory ■■
// Cache a tile of seed points in workgroup shared memory
// to reduce global memory reads. Tile size matches workgroup.
var<workgroup> seedCache: array<vec3f, 256>;

// ■■ Distance Function ■■
// Squared Euclidean distance (avoids sqrt for comparison)
fn distSq(a: vec3f, b: vec3f) -> f32 {
  let d = a - b;
  return dot(d, d);
}

// ■■ Main Compute Kernel ■■
// Each thread processes one vertex, finding its nearest Voronoi seed.
// Uses tiled approach: loads WORKGROUP_SIZE seeds at a time into
// shared memory, then compares all vertices in the workgroup.
@compute @workgroup_size(256, 1, 1)
fn main(
  @builtin(global_invocation_id) globalId: vec3u,
  @builtin(local_invocation_id) localId: vec3u,
) {
  let vertexIdx = globalId.x;

  // Bounds check — excess threads in final workgroup
  if (vertexIdx >= params.vertexCount) {
    return;
  }

  let vertexPos = vertices[vertexIdx];

  // Track nearest seed
  var minDist: f32 = 1e30;
  var nearestSeed: u32 = 0u;

  // Process seeds in tiles of WORKGROUP_SIZE
  let numTiles = (params.seedCount + WORKGROUP_SIZE - 1u) / WORKGROUP_SIZE;

  for (var tile: u32 = 0u; tile < numTiles; tile = tile + 1u) {
    // ── Load seed tile into shared memory ──
    let seedIdx = tile * WORKGROUP_SIZE + localId.x;
    if (seedIdx < params.seedCount) {
      seedCache[localId.x] = seeds[seedIdx];
    }

    // Synchronize workgroup — all threads must finish loading
    workgroupBarrier();

    // ── Compare vertex against all seeds in this tile ──
    let tileEnd = min(WORKGROUP_SIZE, params.seedCount - tile * WORKGROUP_SIZE);
    for (var s: u32 = 0u; s < tileEnd; s = s + 1u) {
      let d = distSq(vertexPos, seedCache[s]);
      if (d < minDist) {
        minDist = d;
        nearestSeed = tile * WORKGROUP_SIZE + s;
      }
    }

    // Synchronize before loading next tile
    workgroupBarrier();
  }

  // ── Write result ──
  cellAssignments[vertexIdx] = nearestSeed;
}

// ■■ Secondary Kernel: Seed Generation ■■
// Generates quasi-random Voronoi seed points within the mesh bounding box.
// Uses a low-discrepancy Halton sequence for uniform coverage.

// Halton sequence base-2 (van der Corput)
fn halton2(index: u32) -> f32 {
  var result: f32 = 0.0;
  var f: f32 = 0.5;
  var i: u32 = index;
  for (var iter: u32 = 0u; iter < 32u; iter = iter + 1u) {
    if (i == 0u) { break; }
    result = result + f * f32(i & 1u);
    i = i >> 1u;
    f = f * 0.5;
  }
  return result;
}

// Halton sequence base-3
fn halton3(index: u32) -> f32 {
  var result: f32 = 0.0;
  var f: f32 = 1.0 / 3.0;
  var i: u32 = index;
  for (var iter: u32 = 0u; iter < 20u; iter = iter + 1u) {
    if (i == 0u) { break; }
    result = result + f * f32(i % 3u);
    i = i / 3u;
    f = f / 3.0;
  }
  return result;
}

// Halton sequence base-5
fn halton5(index: u32) -> f32 {
  var result: f32 = 0.0;
  var f: f32 = 1.0 / 5.0;
  var i: u32 = index;
  for (var iter: u32 = 0u; iter < 14u; iter = iter + 1u) {
    if (i == 0u) { break; }
    result = result + f * f32(i % 5u);
    i = i / 5u;
    f = f / 5.0;
  }
  return result;
}

// Secondary compute kernel — generates seed positions
// Dispatch: ceil(seedCount / 256) workgroups
@compute @workgroup_size(256, 1, 1)
fn generateSeeds(
  @builtin(global_invocation_id) globalId: vec3u,
) {
  let seedIdx = globalId.x;
  if (seedIdx >= params.seedCount) {
    return;
  }

  // Halton quasi-random point in [0, 1]^3
  let h = vec3f(
    halton2(seedIdx + 1u),
    halton3(seedIdx + 1u),
    halton5(seedIdx + 1u),
  );

  // Map to bounding box
  let extent = params.bboxMax - params.bboxMin;
  seeds[seedIdx] = params.bboxMin + h * extent;
}
